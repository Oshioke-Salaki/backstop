# Backstop configuration. `pnpm local` writes a working .env.local for a local chain automatically.

# Public origin of this app (https in production). Used for SIWE, payment links and x402 resource URLs.
PUBLIC_BASE_URL=https://backstop.example

# localhost | base-sepolia | base
NETWORK=base-sepolia
RPC_URL=https://sepolia.base.org

# Deployed BackstopEscrow and the USDC it holds.
ESCROW_ADDRESS=0x...
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# EIP-712 domain of the token, read from name()/version(): "USDC" on Base Sepolia, "USD Coin" on Base mainnet.
USDC_NAME=USDC
USDC_VERSION=2

# Separate keys per duty (see docs/THREAT_MODEL.md). Depositor and settler must differ.
DEPOSITOR_PRIVATE_KEY=0x...
SETTLER_PRIVATE_KEY=0x...
RECEIPT_PRIVATE_KEY=0x...
# Optional: approves provider payout addresses automatically. Without it, approve them from the owner Safe.
REGISTRAR_PRIVATE_KEY=0x...

# Secrets: generate with `openssl rand -base64 48`.
SESSION_SECRET=
CAPABILITY_SECRET=
# 32 bytes, base64: `openssl rand -base64 32`
DATA_KEY=
CRON_SECRET=

# Wallets allowed to resolve disputes, comma-separated.
ADMIN_ADDRESSES=

# Postgres. Leave unset for embedded Postgres in .data/pglite (single process only).
DATABASE_URL=postgres://user:pass@host:5432/backstop

# Optional tuning (defaults shown).
# CONFIRMATIONS=1
# SETTLEMENT_GRACE_SECONDS=21600
# DISPUTE_REVIEW_SECONDS=604800
# DISPUTE_RESPONSE_SECONDS=259200
# MIN_AUTHORIZATION_SECONDS=45
# MAX_REQUEST_BYTES=1048576
# MAX_OPEN_DISPUTES_PER_PAYER=5
# RESPONSE_RETENTION_SECONDS=2592000

# Development only: allow http:// and private-network upstreams. Must be false in production.
ALLOW_PRIVATE_UPSTREAMS=false
# Run the settlement worker inside the web server (single long-running instance only).
WORKER_INLINE=false
